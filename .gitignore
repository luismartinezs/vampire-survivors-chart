# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output and generated build inputs (scripts/build.ts)
/dist/
/site/data/
/site/static/assets/
/site/static/stats-snapshot.json
/.tools/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

tmp
certificates

.codanna
.fastembed_cache

# Local-only: pnpm v11 build-script approvals (allowBuilds). Breaks Vercel's older pnpm.
pnpm-workspace.yaml
